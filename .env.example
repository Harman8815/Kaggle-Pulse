# Kaggle API Credentials (Required)
# Get these from https://www.kaggle.com/settings/account → "Create New Token"
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_API_TOKEN=your_kaggle_api_token

# Optional: Default username for home page (client-safe, no API access)
# NEXT_PUBLIC_USERNAME=your_kaggle_username

# Optional: Daily snapshots for these profiles via POST /api/kaggle/snapshots
# CRON_SECRET=use-a-long-random-secret
# KAGGLE_TRACKED_USERS=username_one,username_two